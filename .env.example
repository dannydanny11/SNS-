# ─────────────────────────────────────────────────────────
#  이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채워 넣으세요.
#  .env 는 .gitignore 에 의해 커밋되지 않습니다.
#  실제 값은 채팅창/코드에 절대 붙여넣지 마세요.
# ─────────────────────────────────────────────────────────

# ① 쿠팡 파트너스 Open API (모듈 ②) — 이미 발급됨
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ② Instagram Graph API (모듈 ⑤) — Phase 0 에서 발급
IG_USER_ID=
IG_ACCESS_TOKEN=

# ③ Claude API (모듈 ④ 캡션 생성)
ANTHROPIC_API_KEY=

# ④ 실행 결과 통지 (모듈 ⑥) — 텔레그램(선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
